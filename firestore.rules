rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAsisten() {
      return isAuthenticated() && getUserRole() == 'asisten';
    }

    function isPraktikan() {
      return isAuthenticated() && getUserRole() == 'praktikan';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /sesi/{sesiId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAsisten();
    }

    // FR-07 & FR-08: Attendance submission and real-time recap
    match /presensi/{presensiId} {
      allow read: if isAsisten() || (isAuthenticated() && resource.data.praktikanId == request.auth.uid);

      allow create: if isPraktikan()
        && request.resource.data.praktikanId == request.auth.uid
        && request.resource.data.sesiId is string
        && presensiId == request.resource.data.sesiId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/presensi/$(presensiId))
        && get(/databases/$(database)/documents/sesi/$(request.resource.data.sesiId)).data.status == 'dibuka'
        && request.resource.data.status == 'HADIR';

      allow update, delete: if false;
    }

    // FR-11, FR-12, FR-13, FR-14: Absence permission submission & assistant approval workflow
    match /izin/{izinId} {
      allow read: if isAsisten() || (isAuthenticated() && resource.data.praktikanId == request.auth.uid);

      allow create: if isPraktikan()
        && request.resource.data.praktikanId == request.auth.uid
        && request.resource.data.sesiId is string
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.resource.data.status == 'pending'
        && izinId == request.resource.data.sesiId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/izin/$(izinId));

      // FR-13: Only assistants can approve or reject, and only when current status is 'pending'
      allow update: if isAsisten()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['disetujui', 'ditolak']
        && request.resource.data.praktikanId == resource.data.praktikanId
        && request.resource.data.sesiId == resource.data.sesiId
        && request.resource.data.alasan == resource.data.alasan;

      allow delete: if false;
    }
  }
}
